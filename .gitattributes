# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare source files as text with LF
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Denote binaries so Git never touches their line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary